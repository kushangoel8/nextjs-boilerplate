# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (used to write the personalized check-in text)
ANTHROPIC_API_KEY=

# OpenAI (used only for text-to-speech voice notes)
OPENAI_API_KEY=

# Twilio (SMS delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe (billing — add once a guardian has co-signed the account)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Random secret string — protects /api/checkins/run from being triggered by
# anyone other than Vercel Cron. Vercel automatically sends this as a Bearer
# token to cron routes when this env var is set.
CRON_SECRET=
